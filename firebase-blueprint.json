{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "password": { "type": "string", "description": "Hashed password" },
        "photoURL": { "type": "string" },
        "lastLogin": { "type": "object" },
        "createdAt": { "type": "object" }
      },
      "required": ["uid", "phoneNumber", "password"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "Message between two users",
      "type": "object",
      "properties": {
        "chatRoomId": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["chatRoomId", "senderId", "receiverId", "text", "createdAt"]
    },
    "AIConversation": {
      "title": "AI Chat Session",
      "description": "A conversation between user and AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "object" },
        "lastActive": { "type": "object" }
      },
      "required": ["userId", "title", "createdAt"]
    },
    "AIMessage": {
      "title": "AI Chat Message",
      "description": "Specific message in an AI conversation",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["conversationId", "role", "content", "timestamp"]
    },
    "ChatConversation": {
      "title": "Peer-to-Peer Conversation",
      "description": "Metadata for a chat between two people",
      "type": "object",
      "properties": {
        "participants": { "type": "array" },
        "lastMessage": { "type": "string" },
        "lastMessageSenderId": { "type": "string" },
        "updatedAt": { "type": "object" }
      },
      "required": ["participants", "updatedAt"]
    },
    "Subject": {
      "title": "Educational Subject",
      "description": "Category for exams, books, and questions",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["name", "icon"]
    },
    "Book": {
      "title": "System Book",
      "description": "Educational book available for students",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "grade": { "type": "string" },
        "subject": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["title", "grade", "subject", "pdfUrl", "createdAt"]
    },
    "Exam": {
      "title": "Past Exam Paper",
      "description": "National or local exam paper available for practice",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "year": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["8th", "Form 4"] },
        "createdAt": { "type": "object" }
      },
      "required": ["title", "subject", "year", "pdfUrl", "type", "createdAt"]
    }
  },
  "firestore": {
    "/books/{bookId}": {
      "schema": "Book",
      "description": "Collection of curriculum books"
    },
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Collection of past exam papers"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/chat_conversations/{chatId}": {
      "schema": "ChatConversation",
      "description": "Peer-to-peer chat sessions"
    },
    "/chat_messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within peer-to-peer chats"
    },
    "/conversations/{conversationId}": {
      "schema": "AIConversation",
      "description": "Stored AI chat sessions"
    },
    "/ai_messages/{aiMessageId}": {
      "schema": "AIMessage",
      "description": "Messages belonging to AI conversations"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Educational subject categories"
    }
  }
}
