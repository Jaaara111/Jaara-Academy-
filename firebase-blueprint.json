{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastLogin": { "type": "object" },
        "createdAt": { "type": "object" }
      },
      "required": ["uid", "phoneNumber"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "Message between two users",
      "type": "object",
      "properties": {
        "chatRoomId": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["chatRoomId", "senderId", "receiverId", "text", "createdAt"]
    },
    "AIConversation": {
      "title": "AI Chat Session",
      "description": "A conversation between user and AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "object" },
        "lastActive": { "type": "object" }
      },
      "required": ["userId", "title", "createdAt"]
    },
    "AIMessage": {
      "title": "AI Chat Message",
      "description": "Specific message in an AI conversation",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["conversationId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Private chat messages"
    },
    "/conversations/{conversationId}": {
      "schema": "AIConversation",
      "description": "Stored AI chat sessions"
    },
    "/ai_messages/{aiMessageId}": {
      "schema": "AIMessage",
      "description": "Messages belonging to AI conversations"
    }
  }
}
